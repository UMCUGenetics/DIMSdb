df <- data.frame(
HMDB = LETTERS[1:5],
adduct = c("M+H", "M+Na", "M+K", "M+H", "M+NH4"),
scanmode = c("pos", "neg", "pos", "neg", "pos"),
Sample1_Run1 = rnorm(5),
Sample1_Run2 = rnorm(5),
Sample2_Run1 = rnorm(5),
Sample2_Run2 = rnorm(5)
)
# Define kolommen zonder groep
ungrouped_cols <- c("HMDB", "adduct", "scanmode")
samples <- c("Sample 1", "Sample 2")
runs <- c("Run 1", "Run 2")
grouped <- setNames(
replicate(length(samples), runs, simplify = FALSE),
samples
)
# Eerste rij: lege cellen voor ungrouped kolommen, daarna group headers
group_row <- c(
lapply(ungrouped_cols, function(x) tags$th(rowspan = length(runs), x)),  # geen colspan
Map(function(name, cols) {
tags$th(colspan = length(runs), name)
}, names(grouped), grouped)
)
# Tweede rij: gewone kolomnamen (alle kolommen in volgorde)
cols_row <- c("Run 1", "Run 2", "Run 1", "Run 2")
col_row <- lapply(cols_row, tags$th)
# Build DT header
sketch <- withTags(
table(
class = 'display',
thead(
tr(group_row),
tr(col_row)
)
)
)
col_order <- c(ungrouped_cols, colnames(df)[grep("_", colnames(df))])
